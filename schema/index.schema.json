{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Index",
  "description": "Manifest of the release: coverage, per-market statistics, known gaps and checksums.",
  "type": "object",
  "required": [
    "dataset",
    "version",
    "released",
    "license",
    "verified",
    "coverage",
    "total_records",
    "session_label",
    "markets",
    "known_gaps",
    "exclusions",
    "checks",
    "files"
  ],
  "properties": {
    "dataset": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "released": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verified": {
      "const": false
    },
    "total_records": {
      "type": "integer",
      "minimum": 0
    },
    "markets": {
      "type": "object",
      "minProperties": 1
    },
    "known_gaps": {
      "type": "array"
    },
    "exclusions": {
      "type": "array"
    },
    "files": {
      "type": "object"
    }
  }
}
